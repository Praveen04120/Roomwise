# Roomwise Server Configuration
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
FRONTEND_DIR=frontend

# Administrator Password (REQUIRED - set a strong secret in .env or host env vars)
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional CORS Allowed Origin (defaults to * if unset)
ALLOWED_ORIGINS=*

# Optional Frontend API Base URL (used when frontend is deployed separately from backend)
VITE_API_URL=
